{
  "name": "@cronrunner/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "compile": "bun build src/index.ts --compile --outfile dist/cronrunner",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "embed": "bun scripts/embed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@cronrunner/shared": "workspace:*",
    "croner": "^9.0.0",
    "cronstrue": "^2.52.0",
    "hono": "^4.7.0",
    "openai": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.8.0"
  }
}
