# Optional. Keys can also be entered in the Settings UI and are stored in the local settings file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Server bind port (default 4747)
CRONRUNNER_PORT=4747
# Override the data directory (default: OS-specific app data dir, see apps/server/src/config.ts)
CRONRUNNER_DATA_DIR=
# Optional: send LLM traffic to an OpenAI/Anthropic-compatible endpoint instead of the
# provider's own servers (corporate proxy, local gateway, or the test mock).
CRONRUNNER_LLM_BASE_URL=
